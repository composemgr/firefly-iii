# Firefly III - Personal Finance Manager
# https://www.firefly-iii.org/

# Timezone
TZ=America/New_York

# Hostname / Domain
BASE_HOST_NAME=localhost
BASE_DOMAIN_NAME=example.com

# App secret key (exactly 32 chars)
APP_SECRET_KEY=changeme_secret_key_32characters

# Admin email (for mail FROM)
APP_ADMIN_EMAIL=firefly@example.com

# Database credentials (MariaDB)
DB_CREATE_DATABASE_NAME=firefly
DB_USER_NAME=firefly
DB_USER_PASS=changeme_db_password
DB_ADMIN_PASS=changeme_admin_password

# Email / SMTP settings
EMAIL_SERVER_HOST=172.17.0.1
EMAIL_SERVER_PORT=587
EMAIL_SERVER_USER=
EMAIL_SERVER_PASS=
